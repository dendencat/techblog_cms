# Cloudflare Tunnel 構成用の nginx 設定のテンプレート。
# nginx イメージの起動時に envsubst で ${BLOG_HOSTNAME} が埋められ、/etc/nginx/conf.d/default.conf になる
# (docker-compose.cloudflare.yml 参照)。値は .env の BLOG_HOSTNAME。
# TLS は Cloudflare のエッジで終端し、cloudflared → nginx は compose 内部ネットワークの HTTP。
# nginx はホストにポートを公開しないため、ここに届くのは cloudflared 経由の通信だけ。

upstream django {
    server django:8000;
}

# エッジが付けた X-Forwarded-Proto をそのまま Django に渡す。欠けている場合は
# Always Use HTTPS 前提で https とみなす(http を名乗る通信は Django がリダイレクトする)。
map $http_x_forwarded_proto $forwarded_proto {
    default https;
    http    http;
}

server {
    listen 80 default_server;
    server_name _;

    # 本番ホスト名以外は応答しない
    return 444;
}

server {
    listen 80;
    server_name ${BLOG_HOSTNAME};

    # クライアントの実 IP は Cloudflare が付ける CF-Connecting-IP から取る。
    # 信頼するのは compose 内部ネットワーク(= cloudflared)からの接続だけ。
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header   CF-Connecting-IP;

    server_tokens off;

    # nosniff / Referrer-Policy / X-Frame-Options / HSTS は Django の SecurityMiddleware が付ける
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

    client_max_body_size 10M;

    location / {
        proxy_pass         http://django;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $remote_addr;
        proxy_set_header   X-Forwarded-Proto $forwarded_proto;
        proxy_redirect     off;

        proxy_buffer_size  16k;
        proxy_buffers      4 16k;
        proxy_buffering    on;
        proxy_connect_timeout 60s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Admin 直アクセスブロック
    location ^~ /admin/ {
        return 404;
    }

    # readiness は内部監視用。外部には出さない(WAF でも遮断している)
    location = /ready/ {
        return 404;
    }

    location /static/ {
        alias   /var/www/static/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        add_header X-Content-Type-Options "nosniff" always;
    }

    location /media/ {
        alias   /var/www/media/;
        expires 30d;
        add_header Cache-Control "public, no-transform";
        add_header X-Content-Type-Options "nosniff" always;
    }
}
