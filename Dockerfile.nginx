# Use an official Nginx image as the base (mainline; 1.25 is no longer maintained)
FROM nginx:1.29-alpine

# Pull in Alpine security fixes published after the base image was built.
RUN apk upgrade --no-cache

# Remove default Nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Copy configuration and static files
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

# static/media are named volumes shared with the django container, which writes them as
# appuser (UID/GID 10001, see Dockerfile.django). Pre-create the mountpoints with that owner so
# a fresh volume gets the right ownership even if nginx is the first container to mount it.
# nginx itself only reads these files.
RUN mkdir -p /var/www/static /var/www/media && chown -R 10001:10001 /var/www/static /var/www/media

# Expose ports
EXPOSE 80
EXPOSE 443

# Start Nginx
CMD ["nginx", "-g", "daemon off;"]
